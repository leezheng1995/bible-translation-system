APP_ENV=local
APP_NAME=bible-translation-system
APP_PORT=8000

CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
DATABASE_URL=sqlite:////app/data/bible_translation.db

OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_TRANSLATION_MODEL=qwen3:14b
OLLAMA_REVIEW_MODEL=gemma4:26b
OLLAMA_DEFAULT_MODEL=qwen3:14b
OLLAMA_EMBEDDING_MODEL=bge-m3

GOOGLE_DRIVE_ROOT_FOLDER_NAME=Bible Translation
GOOGLE_DRIVE_INBOX_FOLDER_NAME=01_inbox_ocr
GOOGLE_DRIVE_PROCESSING_FOLDER_NAME=02_processing
GOOGLE_DRIVE_ARCHIVE_FOLDER_NAME=03_archive
GOOGLE_DRIVE_FAILED_FOLDER_NAME=04_failed
GOOGLE_DRIVE_TOKEN_PATH=/app/secrets/google_drive_token.json

# Day 22 - OpenClaw / Slack Notify
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=
SLACK_WEBHOOK_URL=
CLAW_INTERNAL_BASE_URL=http://127.0.0.1:8000
